{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5080",
  "Service": {
    "BuildVersion": "0.1.0",
    "ProtocolVersion": 1,
    "GameHost": "127.0.0.1",
    "GamePort": 2050,
    "SessionHours": 12,
    "JoinTicketSeconds": 60,
    "RedisPrefix": "waw:",
    "AuthRequestsPerMinutePerAddress": 20,
    "AccountStore": "Postgres",
    "SessionStore": "Redis",
    "MigrationsDirectory": "../../../Database/migrations"
  }
}
