<Project Sdk="Microsoft.NET.Sdk">
  <!--
    End-to-end tests over real processes: the Account/API service (in-process, real Redis), the C++ game server executable
    (child process on a free port) and a scripted game client that uses the Unity client's own protocol code.
    Needs: Redis on 127.0.0.1:6379 and a built server (Server\build.cmd).   dotnet test Tests/EndToEnd
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The Unity sources are written for C# 9 without nullable annotations. -->
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runity/Assets/Scripts/Protocol/**/*.cs" Link="Client/Protocol/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Runity/Assets/Scripts/Net/**/*.cs" Link="Client/Net/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Runity/Assets/Scripts/Domain/**/*.cs" Link="Client/Domain/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Runity/Assets/Scripts/Client/**/*.cs" Link="Client/Client/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../AccountService/src/Runity.AccountService/Runity.AccountService.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
