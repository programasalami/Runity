<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the Unity client's engine-free code (WaW.Protocol, WaW.Net, WaW.Domain, WaW.Client) and its EditMode tests under plain
    .NET - fast, no editor, usable in CI. It compiles the SAME source files Unity compiles; nothing is copied.
      dotnet test Tests/ClientCore
    The same tests also run inside Unity (Test Runner, EditMode).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../WaW/Assets/Scripts/Protocol/**/*.cs" Link="Scripts/Protocol/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../WaW/Assets/Scripts/Net/**/*.cs" Link="Scripts/Net/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../WaW/Assets/Scripts/Domain/**/*.cs" Link="Scripts/Domain/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../WaW/Assets/Scripts/Client/**/*.cs" Link="Scripts/Client/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../WaW/Assets/Tests/EditMode/**/*.cs" Link="Tests/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>
</Project>
